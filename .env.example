# ===== 飞书自建应用凭据(必填) =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# ===== DSH 后端(默认 127.0.0.1:3200,即 dsh web GUI 的地址) =====
DSH_BASE_URL=http://127.0.0.1:3200

# Agent 会话的工作目录(新建 DSH 会话时使用)
DSH_SESSION_CWD=D:\workspace

# 回复分片长度(字符),飞书单条文本消息有大小上限
# REPLY_CHUNK_CHARS=3500

# 日志级别: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
